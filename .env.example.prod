# Copy to .env.prod; use docker compose --env-file .env.prod -f docker/docker-compose.prod.yml ...
# Replace example.com hosts with your deployment URLs; configure the web host separately.
# Server-only settings. Blank values are intentional; no usable credentials ship here.
# Set POSTGRES_PASSWORD and both matching database URLs before starting Compose.
# Percent-encode the password in URLs if it contains URL-reserved characters.
POSTGRES_DB=lucknow_events
POSTGRES_USER=user
POSTGRES_PASSWORD=
# postgresql+asyncpg://<user>:<url-encoded-password>@postgres:5432/<database>
DATABASE_URL=
# postgresql+psycopg2://<user>:<url-encoded-password>@postgres:5432/<database>
ALEMBIC_DATABASE_URL=
REDIS_URL=redis://redis:6379/0

# Optional AI integration; mock mode does not need a provider key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.0-flash
AI_MODE=mock

STORAGE_TYPE=local
LOCAL_STORAGE_PATH=/app/data/snapshots

# Backend admin authentication. Required by production Compose.
# Supply a private JWT signing key and a bcrypt password hash out of band.
# Single-quote hash values in env files to preserve literal $ characters.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

CORS_ORIGINS=https://events.example.com
DEBUG=false
LOG_LEVEL=INFO

# Frontend only: these values are public configuration, NEVER secrets.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
INTERNAL_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_SITE_NAME=Lucknow Tech Events
NEXT_PUBLIC_SITE_URL=https://events.example.com
